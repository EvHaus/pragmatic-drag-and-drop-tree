{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"incremental": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src"
	},
	"extends": "./tsconfig.json",
	"include": ["src/**/*.ts", "src/**/*.tsx", "custom.d.ts"]
}
